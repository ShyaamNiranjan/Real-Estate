PUBLIC_DATABASE_URL=postgresql+psycopg://app_public:<password>@localhost:5432/scrollwalk_dev
HQ_DATABASE_URL=postgresql+psycopg://app_hq:<password>@localhost:5432/scrollwalk_dev

TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:<password>@localhost:5432/scrollwalk_test
TEST_DATABASE_URL=postgresql+psycopg://app_rw:<password>@localhost:5432/scrollwalk_test
