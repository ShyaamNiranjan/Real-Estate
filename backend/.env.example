# Copy of the shape of backend/.env. Real values are generated by scripts/db-bootstrap.ps1.
DB_OWNER_PASSWORD=
DB_RW_PASSWORD=
DB_PUBLIC_PASSWORD=
DB_HQ_PASSWORD=

MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:<password>@localhost:5432/scrollwalk_dev
DATABASE_URL=postgresql+psycopg://app_rw:<password>@localhost:5432/scrollwalk_dev
PUBLIC_DATABASE_URL=postgresql+psycopg://app_public:<password>@localhost:5432/scrollwalk_dev
HQ_DATABASE_URL=postgresql+psycopg://app_hq:<password>@localhost:5432/scrollwalk_dev

TEST_MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:<password>@localhost:5432/scrollwalk_test
TEST_DATABASE_URL=postgresql+psycopg://app_rw:<password>@localhost:5432/scrollwalk_test
TEST_PUBLIC_DATABASE_URL=postgresql+psycopg://app_public:<password>@localhost:5432/scrollwalk_test
TEST_HQ_DATABASE_URL=postgresql+psycopg://app_hq:<password>@localhost:5432/scrollwalk_test

# AI writing help. Leave AI_PROVIDER=stub until a key exists (template text, no network).
# Gemini (development, sample data only):
#   AI_PROVIDER=openai_compatible
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
#   AI_API_KEY=<key>
AI_PROVIDER=stub
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
